# ─────────────────────────────────────────────────────────
# Supabase — Tenant project
# ─────────────────────────────────────────────────────────

# Server-side client (not exposed to browser)
TENANT_SUPABASE_URL=
TENANT_SUPABASE_PUBLISHABLE_KEY=
TENANT_SUPABASE_SERVICE_ROLE_KEY=

# Browser-side client (NEXT_PUBLIC_ prefix required for client components)
# Set to the same project as TENANT_SUPABASE_* above
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local dev only — activates shouldUseLocalTenantDbFallback(); DO NOT set in production
TENANT_DB_URL=

# ─────────────────────────────────────────────────────────
# Supabase — Control plane project (separate Supabase project)
# ─────────────────────────────────────────────────────────

CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_SUPABASE_PUBLISHABLE_KEY=
CONTROL_PLANE_SUPABASE_SERVICE_ROLE_KEY=

# Local dev only — activates shouldUseLocalControlPlaneFallback(); DO NOT set in production
CONTROL_PLANE_DB_URL=

# ─────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:4200

# Cron route authentication — required in production, optional in local dev
# Generate with: openssl rand -hex 32
CRON_SECRET=

# DO NOT set to "true" on a real church's production deploy. It permits every
# provider stub (Stripe, SendGrid, Twilio, Resend) to report a fake
# "succeeded" payment or send, and opens /api/demo/* to anyone. Exists only
# for the sales/evaluation demo deployment (S4, Council Review 31, O5).
NEXT_PUBLIC_DEMO_MODE=

# ─────────────────────────────────────────────────────────
# Security — Data Encryption (Phase 2 hardening, PR #111)
# ─────────────────────────────────────────────────────────

# AES-256-GCM key for encrypting pastoral_notes.content and care_assignments.summary at rest.
# REQUIRED in production — app throws on any pastoral read/write if absent in NODE_ENV=production.
# In local dev: omit or leave blank to use plaintext fallback (a console warning is shown).
# Generate with: openssl rand -base64 32
# WARNING: loss of this key = permanent loss of all encrypted pastoral data. Back it up.
PASTORAL_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────
# Communications — Email (Resend — primary provider)
# Provider selection (G5.1): Resend is used when BOTH RESEND_API_KEY and
# RESEND_FROM_EMAIL are set; otherwise SendGrid when BOTH SENDGRID_API_KEY and
# SENDGRID_FROM_EMAIL are set. With neither, sends return stub results in local
# dev/demo and `provider_not_configured` in production.
# ─────────────────────────────────────────────────────────

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Resend webhook signing secret — copy the full whsec_... string from Resend dashboard.
# Every webhook below fails closed: while its secret is unset, the route rejects
# every request, in every environment (S2).
RESEND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────
# Communications — Email (SendGrid — alternative provider)
# ─────────────────────────────────────────────────────────

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# The Event Webhook's "Verification Key" (an ECDSA public key, base64) from
# SendGrid's signed event webhook settings; a PEM public key also works.
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# ─────────────────────────────────────────────────────────
# Communications — SMS (Twilio)
# ─────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
# Also verifies Twilio's status callbacks, which are signed against
# NEXT_PUBLIC_APP_URL — set it to the URL Twilio calls.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Unsubscribe link HMAC signing secret — required in production
# Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# ─────────────────────────────────────────────────────────
# Payments — Stripe
# When absent, donation initiation returns a stub client_secret (safe for local dev)
# ─────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=
# Required for /api/webhooks/stripe: unset, every event is rejected; events
# signed more than five minutes ago are rejected as replays.
STRIPE_WEBHOOK_SECRET=
# The platform's publishable key: Stripe's card form loads with it, on the
# church's connected account (G3.0, ADR 0025).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Connect (G3.0b, ADR 0025): every church's payments are direct
# charges on its own Standard Stripe account, linked by a church admin
# through Stripe OAuth. Online giving and paid registration are live only
# with STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY and this client
# id (Stripe Dashboard → Connect → Settings → OAuth), and only for a church
# that has connected. Register the OAuth redirect URI
# ${NEXT_PUBLIC_APP_URL}/api/stripe/connect/callback in the same settings.
STRIPE_CONNECT_CLIENT_ID=
# The signing secret of the Connect webhook endpoint (events from connected
# accounts), pointed at /api/webhooks/stripe alongside the account endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────
# AI gateway (S22, ADR 0027) — every LLM call goes through lib/ai/gateway.ts
# OpenRouter is primary: ranked per-feature model lists, zero-data-retention
# routing (fails closed if no ZDR endpoint serves a model), cost logged per call.
# When no key is set at all, AI features return a graceful "not configured" error.
# ─────────────────────────────────────────────────────────

# Server-side only — never prefix with NEXT_PUBLIC_. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Backup path: used only when OPENROUTER_API_KEY is unset. Direct Anthropic has no
# cross-vendor fallback and logs tokens but no cost. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional per-feature overrides. <FEATURE> is HQ_ADVISOR, HQ_COUNCIL_SEAT,
# HQ_COUNCIL_SYNTHESIS or MINISTRY.
# AI_MODELS_<FEATURE>: comma list of OpenRouter model ids in priority order, e.g.
#   AI_MODELS_HQ_ADVISOR=anthropic/claude-sonnet-5.5,google/gemini-2.5-pro
# AI_ANTHROPIC_MODEL_<FEATURE>: the direct Anthropic model id for that feature.
AI_MODELS_HQ_ADVISOR=
AI_MODELS_HQ_COUNCIL_SEAT=
AI_MODELS_HQ_COUNCIL_SYNTHESIS=
AI_MODELS_MINISTRY=
AI_ANTHROPIC_MODEL_HQ_ADVISOR=
AI_ANTHROPIC_MODEL_HQ_COUNCIL_SEAT=
AI_ANTHROPIC_MODEL_HQ_COUNCIL_SYNTHESIS=
AI_ANTHROPIC_MODEL_MINISTRY=
# Older aliases, still honoured for the direct Anthropic path only (per-feature
# AI_ANTHROPIC_MODEL_* wins). Defaults: claude-sonnet-5-5 (HQ seats and advisor),
# claude-opus-5-5 (Council synthesis), claude-haiku-4-5-20251001 (ministry).
AI_MINISTRY_MODEL=
AI_HQ_MODEL=

# ─────────────────────────────────────────────────────────
# Web-Push Notifications (optional)
# Generate key pair: npx web-push generate-vapid-keys
# When absent, push notification dispatch is skipped gracefully
# ─────────────────────────────────────────────────────────

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────
# Localization Governance (CC-L10N-001)
# ─────────────────────────────────────────────────────────

# Supabase transaction-pooler postgres URL for localization governance operations
# Server-side only — never prefix with NEXT_PUBLIC_
# Get from: Supabase dashboard > Project Settings > Database > Connection string > Transaction pooler
LOCGOV_DATABASE_URL=

# Optional — only needed for CLI operations (locgov commands)
LOCGOV_CHURCH_ID=
LOCGOV_ACTOR_ID=

# Optional — enables machine translation via Google Cloud Translation API
# Server-side only — never prefix with NEXT_PUBLIC_
GOOGLE_TRANSLATE_API_KEY=

# ─────────────────────────────────────────────────────────
# Observability (Sentry + Vercel Analytics/Speed Insights)
# ─────────────────────────────────────────────────────────
# See docs/setup/observability.md. All optional -- the app runs fine with
# none of these set; error tracking and source-map upload are simply
# disabled. Vercel Analytics/Speed Insights need no env vars at all --
# enable them as a toggle in the Vercel project dashboard.

# Server-side error/performance init (instrumentation.ts)
SENTRY_DSN=
# Browser-side error/performance init (instrumentation-client.ts)
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (better stack traces).
# Get from Sentry dashboard > Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────
# Legacy / do not use for new code
# ─────────────────────────────────────────────────────────

# Pre-ADR 0002 single-backend vars — kept for reference only
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are superseded
# by TENANT_SUPABASE_* and NEXT_PUBLIC_SUPABASE_* above
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Optional local demo bootstrap override
CHURCHFORGE_DEV_PASSWORD=
